{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Debug Spring Boot App",
      "request": "launch",
      "mainClass": "com.example.ecommerce.EcommerceApplication",
      "projectName": "ecommerce-api",
      "args": "",
      "env": {}
    },
    {
      "type": "java",
      "name": "Debug Spring Boot App (production)",
      "request": "launch",
      "mainClass": "com.example.ecommerce.EcommerceApplication",
      "projectName": "ecommerce-api",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SPRING_PROFILES_ACTIVE": "production"
      }
    },
    {
      "type": "java",
      "name": "Attach to Spring Boot",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    }
  ]
}
